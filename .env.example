# ============================================
# MiFicha Backend - Variables de Entorno
# ============================================

# Aplicación
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=MiFicha Backend API
API_VERSION=1.0.0

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://mificha_user:mificha_password@mificha-db:5432/mificha_db
DATABASE_HOST=mificha-db
DATABASE_PORT=5432
DATABASE_NAME=mificha_db
DATABASE_USER=mificha_user
DATABASE_PASSWORD=mificha_password

# Autenticación JWT (para implementar posteriormente)
SECRET_KEY=your-secret-key-change-in-production-12345678901234567890
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Seguridad
SECURE_COOKIES=false
SAME_SITE_COOKIES=lax

# Email (para recuperación de contraseña, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@mificha.com
SMTP_FROM_NAME=MiFicha

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_FILE=logs/mificha.log
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# Sentry (Error Tracking) - Opcional
SENTRY_DSN=

# Redis (para caché y sesiones) - Opcional
REDIS_URL=redis://redis:6379/0

# AWS S3 (para almacenamiento de archivos) - Opcional
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=mificha-bucket

# Twilio (para SMS) - Opcional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=